# =============================================================================
# VARIABLES DE ENTORNO PARA DEUDORES TIENDA (VERCEL Y LOCAL)
# =============================================================================

# Entorno
NODE_ENV=production
PORT=3000

# Base de datos Supabase (Obtenidas en Project Settings > API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta-aqui
SUPABASE_ANON_KEY=tu-anon-key-aqui

# Seguridad JWT
JWT_SECRET=tu_clave_secreta_super_segura_de_produccion_2026
JWT_EXPIRES_IN=7d

# Origenes permitidos para CORS separados por coma (vacio = permitir cualquiera)
# CORS_ORIGINS=https://deudores-tienda.vercel.app,http://localhost:4200
CORS_ORIGINS=
