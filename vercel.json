{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist/frontend/browser",
  "functions": {
    "backend/api/index.ts": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
