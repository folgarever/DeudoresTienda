# Configuracion del Servidor
PORT=3000
NODE_ENV=development

# Credenciales de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
SUPABASE_ANON_KEY=tu-anon-key-aqui

# Seguridad JWT
# En produccion JWT_SECRET es OBLIGATORIO (la API no arranca sin el).
JWT_SECRET=tu_clave_secreta_super_segura_aqui
JWT_EXPIRES_IN=7d

# Origenes permitidos para CORS separados por coma.
# Si se deja vacio se permite cualquier origen (recomendado solo en desarrollo).
# En produccion use el dominio del frontend, por ejemplo:
# CORS_ORIGINS=https://deudores-tienda.vercel.app,http://localhost:4200
CORS_ORIGINS=
